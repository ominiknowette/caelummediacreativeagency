# ==============================================================================
# Caelum Media - Enquiry Email Configuration (Server-Side Only)
# ==============================================================================
# IMPORTANT:
# - Do NOT prefix these variables with NEXT_PUBLIC_ (keep them server-only).
# - Never commit actual API keys or secret credentials to Git.
# - For local development: copy this file to .env.local and fill in the values.
# - In production (e.g. Vercel): set these in Project Settings -> Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# OPTION 1: EmailJS (Recommended when sending without a custom domain)
# ------------------------------------------------------------------------------
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
# Optional Private Key / Access Token:
EMAILJS_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# OPTION 2: SendByte (For custom domain with verified SPF/DKIM DNS records)
# ------------------------------------------------------------------------------
# - Use 'sk_test_...' for sandbox testing.
# - Use 'sk_live_...' for production (requires verified sender domain in SendByte).
SENDBYTE_API_KEY=
# Sender email on your verified domain:
SENDBYTE_FROM_EMAIL=

# ------------------------------------------------------------------------------
# Destination Inbox (Where notification emails will be delivered)
# ------------------------------------------------------------------------------
ENQUIRY_TO_EMAIL=caelummediacreativeagency@gmail.com

# Public site URL (for production origin verification)
CAELUM_PUBLIC_SITE_URL=
